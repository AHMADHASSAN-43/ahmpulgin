// plugins/fullpp.js
import { fileURLToPath } from 'url';
import { cmd } from '../command.js';
import { Jimp } from 'jimp';

const S_WHATSAPP_NET = '@s.whatsapp.net';
const __filename = fileURLToPath(import.meta.url);

// Pakistan (92) ke hisaab se number normalize karo
function normalizePK(input) {
    let n = input.replace(/[^0-9]/g, '');
    if (n.startsWith('0092')) n = n.slice(2);        // 0092300... -> 92300...
    else if (n.startsWith('92')) { /* already ok */ }
    else if (n.startsWith('0')) n = '92' + n.slice(1); // 0300... -> 92300...
    else if (n.length === 10 && n.startsWith('3')) n = '92' + n; // 300... -> 92300...
    return n;                                         // baaki countries ke numbers jaise hain
}

cmd({
    pattern: "fullpp",
    alias: ["setpp", "setdp", "pp", "setppbot"],
    react: "🖼️",
    desc: "Owner Only - Set bot's profile picture (reply to image or give number)",
    category: "owner",
    filename: __filename
}, async (client, message, m, { from, isCreator, q, args }) => {
    try {
        if (!isCreator) {
            return await client.sendMessage(from, { text: "*📛 This is an owner command.*" }, { quoted: message });
        }

        const input = (q || (args || []).join(' ') || '').trim();
        const number = normalizePK(input);
        let buffer;

        if (number.length >= 10) {
            const jid = number + S_WHATSAPP_NET;
            let url;
            try {
                url = await client.profilePictureUrl(jid, 'image');
            } catch {
                return await client.sendMessage(from, {
                    text: "*❌ Is number ki DP nahi mili (DP hidden hai, number galat hai, ya WhatsApp par nahi hai).*"
                }, { quoted: message });
            }
            const res = await fetch(url);
            if (!res.ok) throw new Error("DP download failed: " + res.status);
            buffer = Buffer.from(await res.arrayBuffer());

        } else if (m.quoted && m.quoted.mtype === "imageMessage") {
            buffer = await m.quoted.download();

        } else {
            return await client.sendMessage(from, {
                text: "*🍁 Use:*\n• Image par reply karke *.fullpp*\n• Ya *.fullpp 03001234567*"
            }, { quoted: message });
        }

        const jimp = await Jimp.read(buffer);
        jimp.scaleToFit({ w: 720, h: 720 });
        const img = await jimp.getBuffer('image/jpeg', { quality: 80 });

        await client.query({
            tag: 'iq',
            attrs: { target: undefined, to: S_WHATSAPP_NET, type: 'set', xmlns: 'w:profile:picture' },
            content: [{ tag: 'picture', attrs: { type: 'image' }, content: img }]
        });

        await client.sendMessage(from, { text: "*✅ Bot's profile picture updated successfully!*" }, { quoted: message });
    } catch (error) {
        console.error("fullpp Error:", error);
        await client.sendMessage(from, { text: "❌ Error updating profile picture:\n" + error.message }, { quoted: message });
    }
});
